{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Parrot",
  "version": "0.1.0",
  "identifier": "io.github.qwertymuzaffar.parrot",
  "build": {
    "frontendDist": "../dist/parrot/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Parrot",
        "width": 1240,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Read a text aloud and see which words came out wrong"
  },
  "mainBinaryName": "Parrot"
}